<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📚 Study Timer"
            android:textSize="32sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="आज का Study Plan"
            android:textSize="18sp"
            android:gravity="center"
            android:layout_marginBottom="28dp" />

        <Button
            android:id="@+id/btnMaths"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:text="1. Maths\n2 घंटे 40 मिनट"
            android:textSize="18sp"
            android:layout_marginBottom="14dp" />

        <Button
            android:id="@+id/btnReasoning"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:text="2. Reasoning\n2 घंटे"
            android:textSize="18sp"
            android:layout_marginBottom="14dp" />

        <Button
            android:id="@+id/btnGkGs"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:text="3. GK / GS\n2 घंटे"
            android:textSize="18sp"
            android:layout_marginBottom="14dp" />

        <Button
            android:id="@+id/btnMpGk"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:text="4. MP GK\n1 घंटा"
            android:textSize="18sp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/txtTimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="00:00:00"
            android:textSize="42sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="⏹ Stop Timer"
            android:textSize="18sp" />

    </LinearLayout>

</ScrollView>
